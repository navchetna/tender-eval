# Tender Evaluation — desktop settings.
#
# Edit this file, save it, then restart Tender Evaluation (tray icon -> Quit, then launch it
# again). Any setting from pydantic_backend/config.py can be added here as NAME=value.

# The first admin account, created on first start. Sign in to the app with these.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Quality-tier model (compliance judgment, scoring, final comparison) — the one cloud call.
ANTHROPIC_API_KEY=
ANTHROPIC_QUALITY_MODEL=claude-sonnet-4-5

# Gmail + Drive ingestion: a Google Cloud OAuth client of type "Desktop application", with the
# Gmail API and Drive API enabled. After filling these in and restarting, use the tray icon's
# "Connect Gmail..." to sign in once.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_QUERY=is:unread has:attachment filename:pdf
# Where reviewer notification emails go (leave empty to skip notifications).
REVIEWER_EMAIL=

# On-device models (OpenVINO, run inside this app — no model servers). Devices: NPU, GPU, CPU.
# A device that's missing or can't load the model falls back to GPU, then CPU.
LOCAL_FAST_MODEL_DEVICE=NPU
LOCAL_OCR_MODEL_DEVICE=GPU
