# Tender Evaluation - desktop settings
#
# The installer copies this file to %LOCALAPPDATA%\TenderEval\config.env (filling in whatever
# you entered on its "Settings" page). Edit that copy - never this example - then restart the
# app (tray icon -> Quit, then launch Tender Evaluation again). Settings take effect on restart.
#
# Only the admin account is required. Everything else is optional: leave a value empty to turn
# that feature off. Any setting from pydantic_backend/config.py can be added as NAME=value.

# --- Admin account (required) ------------------------------------------------------------------
# Sign in to the app with these. Changing ADMIN_PASSWORD here resets the admin's password on the
# next start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Claude (optional) -------------------------------------------------------------------------
# Used for the compliance matrix, scoring and the final comparison. Without it, those run on the
# on-device Qwen model instead (Operations page -> "Reasoning model" switches between them).
#
# Option A - Anthropic API: a key from console.anthropic.com (starts with "sk-ant-").
# Option B - Claude on Azure AI Foundry: the Foundry key in ANTHROPIC_API_KEY, plus
#            ANTHROPIC_BASE_URL=https://<your-resource>.openai.azure.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_QUALITY_MODEL=claude-sonnet-4-5
#
# Option C - an OpenAI-compatible gateway (LiteLLM, an enterprise AI gateway). When
#            QUALITY_LLM_BASE_URL is set, these are used and the ANTHROPIC_* values are ignored.
QUALITY_LLM_BASE_URL=
QUALITY_LLM_API_KEY=
QUALITY_LLM_MODEL=claude-sonnet-4-5

# --- Gmail + Google Drive (needed to upload or ingest documents) ------------------------------
# A Google Cloud OAuth client of type "Desktop app", with the Gmail API and Google Drive API
# enabled (console.cloud.google.com -> APIs & Services -> Credentials). Then, in the app, click
# "Connect Google" on the Projects page once to sign in.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_QUERY=is:unread has:attachment filename:pdf
# Drive folder that holds all projects. Empty = a "Tender Evaluation" folder in your own My Drive
# (created automatically). To share one folder across a team, paste its ID from the folder's URL.
DRIVE_PARENT_FOLDER_ID=
# Where reviewer notification emails go. Empty = no notification emails.
REVIEWER_EMAIL=

# --- On-device models -------------------------------------------------------------------------
# Run inside the app with OpenVINO (no model servers). Devices: NPU, GPU or CPU. A device that's
# missing or can't load the model falls back to GPU, then CPU.
LOCAL_FAST_MODEL_DEVICE=NPU
LOCAL_OCR_MODEL_DEVICE=GPU
