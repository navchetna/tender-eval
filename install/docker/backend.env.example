# Copy this file to backend.env in this same directory and fill in every value, then
# `docker compose up -d --build`. backend.env is gitignored — never commit it.
#
# Sanitized copy of pydantic_backend/.env.example — three differences: that file's
# ADMIN_LITELLM_KEY had a real key value checked in, replaced below with a placeholder;
# CORS_ORIGINS is added below since it's required once the frontend is served from a
# different origin than the backend (not needed for the localhost:3000 dev setup, hence
# absent from the original .env.example); and DATABASE_URL is deliberately absent — the
# compose file wires it directly from ../docker/.env (POSTGRES_USER/PASSWORD/DB) to the
# bundled `postgres` service, so it can't drift out of sync with that service's own
# credentials. Only add DATABASE_URL here if you delete the postgres service from
# docker-compose.yaml and point this backend at an external Postgres instead.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_QUERY=is:unread has:attachment filename:pdf
LOGFIRE_SEND=true
# A write token for your Logfire project — required in a container, which has no local
# `logfire auth` session to fall back on. Get one from your project's settings page, or from
# .logfire/logfire_credentials.json after running `logfire projects use` locally.
LOGFIRE_TOKEN=

# --- PDF parser (stage 2): enterprise agentic toolkit's PDF pipeline ---
PARSER_BASE_URL=https://ei-api.mg2.eglb.intel.com/pdf-pipeline
PARSER_USER=tender-bid
PARSER_VERIFY_TLS=false
PARSER_API_KEY=
# A real conversion on this CPU-only pipeline runs ~20-25 minutes under normal conditions
# (measured: 1305s and 1326s for two real tender/bid PDFs) — polling every 5s (the old
# default) both hammers the pipeline with ~250 needless requests per file and, worse, the
# old 120-attempt cap (600s total) gave up and reported "Timed out waiting for parser" long
# before the pipeline was actually done. Conversions can also run much longer than that
# baseline when this node's other co-located vLLM servers are also busy (no CPU isolation
# between pods here — see ../helm/lighton-ocr/README.md), so patience is set to match the
# pipeline's own per-request VLM timeout (7200s) rather than the best-case baseline: 180s x
# 40 = 7200s (2hr) of patience, checked sparingly.
PARSE_POLL_INTERVAL_SECONDS=180
PARSE_MAX_POLL_ATTEMPTS=40
PARSE_WORKER_ENABLED=true
PARSE_WORKER_INTERVAL_SECONDS=30
PARSE_BATCH_SIZE=5
PARSE_MAX_ATTEMPTS=3

# --- Tender/bid evaluation (stage 3): LiteLLM gateway (enterprise agentic toolkit) ---
LITELLM_BASE_URL=https://ei-api.mg2.eglb.intel.com/v1
LITELLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LITELLM_VERIFY_TLS=false
# Fernet key used to encrypt each employee's LiteLLM key at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LITELLM_KEY_ENCRYPTION_KEY=
# Used only by the unattended background pipeline worker (no employee is logged in there)
LITELLM_WORKER_API_KEY=
REVIEWER_EMAIL=
EVAL_BATCH_SIZE=5

# --- Auth (stage 4) ---
# Bootstrapped as the first ADMIN employee whenever POST /setup/database runs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
# The admin's own LiteLLM key, encrypted at rest and set on first bootstrap only.
ADMIN_LITELLM_KEY=

# --- CORS (stage 5): browser origins allowed to call this API directly ---
# Must include the frontend's real origin once it's served from somewhere other than
# localhost:3000, or the browser will reject every request from it.
CORS_ORIGINS=["https://<your-frontend-domain>"]
