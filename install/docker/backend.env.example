# Copy this file to backend.env in this same directory and fill in every value, then
# `docker compose up -d --build`. backend.env is gitignored — never commit it.
#
# DATABASE_URL is deliberately absent — the compose file wires it directly from ../docker/.env
# (POSTGRES_USER/PASSWORD/DB) to the bundled `postgres` service, so it can't drift out of sync
# with that service's own credentials. Only add DATABASE_URL here if you delete the postgres
# service from docker-compose.yaml and point this backend at an external Postgres instead.

GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_QUERY=is:unread has:attachment filename:pdf
LOGFIRE_SEND=true
# A write token for your Logfire project — required in a container, which has no local
# `logfire auth` session to fall back on. Get one from your project's settings page, or from
# .logfire/logfire_credentials.json after running `logfire projects use` locally.
LOGFIRE_TOKEN=

# --- PDF parser (stage 2): local LightOnOCR (GPU) service, docling-compatible /api/convert contract ---
# Host-native process (needs direct GPU access), reached from this container via
# host.docker.internal — see docker-compose.yaml's backend.extra_hosts.
PARSER_BASE_URL=http://host.docker.internal:8010
PARSER_USER=tender-bid
PARSER_VERIFY_TLS=false
PARSER_API_KEY=
PARSE_POLL_INTERVAL_SECONDS=5
PARSE_MAX_POLL_ATTEMPTS=120
PARSE_WORKER_ENABLED=true
PARSE_WORKER_INTERVAL_SECONDS=30
PARSE_BATCH_SIZE=5
PARSE_MAX_ATTEMPTS=3

# --- Tender/bid evaluation (stage 3): local LiteLLM proxy (see litellm.env.example +
# litellm-config.yaml in this same directory) fronting the NPU-served Qwen3 (fast tier) and
# Claude (quality tier) ---
# litellm runs with network_mode: host (needed so it can reach the Windows-hosted OVMS via
# plain localhost), which detaches it from this compose project's bridge network — so it is
# NOT reachable by service name from this container. Reach it via host.docker.internal instead,
# same as PARSER_BASE_URL above.
LITELLM_BASE_URL=http://host.docker.internal:4000
# Must match LITELLM_MASTER_KEY in litellm.env — generate with:
#   python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=
LITELLM_FAST_MODEL=npu-qwen3-4b
# Must match the `model_name` you give the Claude model when adding it via the LiteLLM Admin
# UI (Models -> Add Model) — that model is DB-managed, not defined in litellm-config.yaml, so
# there's no fixed name to reference here until you've added it yourself.
LITELLM_QUALITY_MODEL=claude-sonnet-4-5
LITELLM_VERIFY_TLS=false
REVIEWER_EMAIL=navchetna.intel@gmail.com
EVAL_BATCH_SIZE=5

# --- Auth (stage 4) ---
# Bootstrapped as the first ADMIN employee whenever POST /setup/database runs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- CORS (stage 5): browser origins allowed to call this API directly ---
# Must include the frontend's real origin once it's served from somewhere other than
# localhost:3000, or the browser will reject every request from it.
CORS_ORIGINS=["*"]
