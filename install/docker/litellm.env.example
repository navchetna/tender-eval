# Copy this file to litellm.env in this same directory and fill in every value.
# litellm.env is gitignored — never commit real secrets into this directory.

# Shared secret between the backend and this proxy — must match LITELLM_MASTER_KEY in
# backend.env. Generate with: python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=

# Used for the claude-eval model (judgment/scoring/comparison calls) once added via the UI.
ANTHROPIC_API_KEY=

# Lets models be added/edited/deleted from the Admin UI (persisted to Postgres) instead of only
# being defined in litellm-config.yaml, where they'd be reloaded from the file on every restart
# and couldn't be edited/deleted from the UI.
STORE_MODEL_IN_DB=True
