# Copy this file to backend.env in this same directory and fill in every value, then
# follow README.md to build the secret from it. backend.env is gitignored — never commit it.
#
# This is the Kubernetes counterpart of ../docker/backend.env.example — same app config,
# except DATABASE_URL is included here (not left out) because there's no bundled Postgres
# in this deployment path: it must point at the enterprise agent toolkit's Postgres instead.
# See README.md's "Create the secret" step for how to provision a separate `tender_eval`
# database there and what value to put below.

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_QUERY=is:unread has:attachment filename:pdf
LOGFIRE_SEND=true
# A write token for your Logfire project — required in a container, which has no local
# `logfire auth` session to fall back on. Get one from your project's settings page, or from
# .logfire/logfire_credentials.json after running `logfire projects use` locally.
LOGFIRE_TOKEN=

# --- Database: the enterprise agent toolkit's Postgres, not a bundled one ---
# See README.md's "Create the secret" step — this must point at a separate `tender_eval`
# database on the toolkit's genai-gateway-postgresql instance, not its `litellm` database.
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@genai-gateway-postgresql.genai-gateway.svc.cluster.local:5432/tender_eval

# --- PDF parser (stage 2): enterprise agentic toolkit's PDF pipeline ---
# Internal cluster service address, NOT the external ei-api.mg2.eglb.intel.com/pdf-pipeline
# host — this backend runs in the SAME cluster as pdf-pipeline, and routing out through the
# external ingress hostname and back in hits a hairpin NAT failure (no real LoadBalancer
# here — ingress-nginx-controller's EXTERNAL-IP is <pending> — so pod egress traffic to that
# hostname's resolved public IP can't loop back into the cluster); see
# ../helm/pdf-pipeline/README.md. Only use the external form if this backend runs OUTSIDE
# this cluster.
PARSER_BASE_URL=http://pdf-pipeline.pdf-pipeline.svc.cluster.local:8010
PARSER_USER=tender-bid
PARSER_VERIFY_TLS=false
PARSER_API_KEY=
PARSE_POLL_INTERVAL_SECONDS=180
PARSE_MAX_POLL_ATTEMPTS=40
PARSE_WORKER_ENABLED=true
PARSE_WORKER_INTERVAL_SECONDS=30
PARSE_BATCH_SIZE=5
PARSE_MAX_ATTEMPTS=3

# --- Tender/bid evaluation (stage 3): LiteLLM gateway (enterprise agentic toolkit) ---
LITELLM_BASE_URL=http://genai-gateway-service.genai-gateway.svc.cluster.local:4000/v1
LITELLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LITELLM_VERIFY_TLS=false
# Fernet key used to encrypt each employee's LiteLLM key at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LITELLM_KEY_ENCRYPTION_KEY=
# Used only by the unattended background pipeline worker (no employee is logged in there)
LITELLM_WORKER_API_KEY=
REVIEWER_EMAIL=navchetna.intel@gmail.com
EVAL_BATCH_SIZE=5

# --- Auth (stage 4) ---
# Bootstrapped as the first ADMIN employee whenever POST /setup/database runs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
# The admin's own LiteLLM key, encrypted at rest and set on first bootstrap only.
ADMIN_LITELLM_KEY=

# --- CORS (stage 5): browser origins allowed to call this API directly ---
# Must include the frontend's real origin (this deployment never serves it from
# localhost:3000), or the browser will reject every request from it.
CORS_ORIGINS=["*"]
